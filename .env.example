# Supabase (Postgres only — no Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Custom JWT auth
JWT_SECRET=your-secret-key-min-32-chars

# Python AI service (local dev). On Vercel, set to your Render URL, e.g. https://youthpay-ai.onrender.com
PARSER_API_URL=http://localhost:8000

# Optional — not used by app code today; set on Vercel if you add absolute URLs later
NEXT_PUBLIC_APP_URL=http://localhost:3000
